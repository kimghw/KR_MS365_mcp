# Azure AD OAuth 설정
AZURE_CLIENT_ID=your_client_id_here
AZURE_CLIENT_SECRET=your_client_secret_here
AZURE_TENANT_ID=your_tenant_id_here
AZURE_REDIRECT_URI=http://localhost:5000/callback

# 선택적 설정
AZURE_AUTHORITY=https://login.microsoftonline.com
# 스코프는 공백으로 구분 (미설정 시 기본값: https://graph.microsoft.com/.default offline_access openid)
# offline_access가 없으면 refresh_token이 발급되지 않음
AZURE_SCOPES=https://graph.microsoft.com/.default offline_access openid


# =============================================================================
# 네트워크 바인드
# 자세한 설명: docs/environment_variables.md
# =============================================================================
# [중요] 기본 바인드 주소가 0.0.0.0 -> 127.0.0.1(loopback) 로 바뀌었다.
# MCP 서버에는 호출자 인증이 전혀 없어서, 포트에 도달 가능한 사람은 누구나
# 인증 없이 메일/일정/파일을 읽고 쓸 수 있기 때문이다.
#
# 아무것도 설정하지 않으면 127.0.0.1 로 뜬다 — 이것이 안전한 기본값이다.
# MCP_BIND_HOST=127.0.0.1

# 외부(다른 PC)에서 접속해야 할 때만 아래 두 줄을 함께 켠다.
# MCP_BIND_HOST 만 바꾸면 옵트인이 없다고 판단해 loopback 으로 강등된다.
#
#   [경고] 켜기 전에 반드시 Windows 방화벽에서 출발지 IP 를 제한할 것.
#          가능하면 0.0.0.0 대신 특정 내부망 IP(예: 192.168.0.10)를 지정하고,
#          더 안전하게는 SSH 터널/WireGuard 로만 노출하라.
# MCP_BIND_HOST=192.168.0.10
# MCP_ALLOW_PUBLIC_BIND=1

# 서버가 listen 할 포트 (미설정 시 서버별 기본값, 예: outlook 5001)
# MCP_SERVER_PORT=5001


# =============================================================================
# 파일 접근 허용 경로
# =============================================================================
# 파일 읽기/쓰기를 허용할 루트 목록. 구분자는 OS 기본값(Windows ';', Linux/macOS ':').
# 미설정 시 프로젝트 루트(+ MCP_DATA_DIR)만 허용된다.
# 허용 범위는 필요한 만큼만 좁게 잡을 것 (C:\ 나 홈 전체를 넣으면 의미가 없다).
# MCP_ALLOWED_PATHS=E:\dev\KR_MS365_mcp\downloads;E:\dev\KR_MS365_mcp\output

# 기본 허용 루트에 추가로 붙일 데이터 디렉터리
# MCP_DATA_DIR=


# =============================================================================
# 입력 검증
# =============================================================================
# 도구 입력 스키마 검증. 미설정이면 켜짐(권장).
# 0/false/no/off 로 두면 꺼진다 — 긴급 우회용이며 정상 운영 중에는 끄지 말 것.
# MCP_VALIDATE_INPUT=1


# =============================================================================
# 기본 사용자
# =============================================================================
# 도구 호출에 이메일 인자가 없을 때 사용할 기본 사용자.
# 미설정 시 auth.db 에서 결정적으로 선택한다(유효 토큰 보유자 우선 -> 이메일 사전순).
# MS365_DEFAULT_USER_EMAIL=user@example.com


# =============================================================================
# 기타
# =============================================================================
# 도구 정의 YAML 경로 직접 지정.
# 미설정 시 <project_root>/mcp_editor/mcp_<서버>/tool_definition_templates.yaml
# MCP_YAML_PATH=