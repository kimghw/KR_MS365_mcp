# Azure AD OAuth 설정
AZURE_CLIENT_ID=your_client_id_here
AZURE_CLIENT_SECRET=your_client_secret_here
AZURE_TENANT_ID=your_tenant_id_here
AZURE_REDIRECT_URI=http://localhost:5000/callback

# 선택적 설정
AZURE_AUTHORITY=https://login.microsoftonline.com
# 스코프는 공백으로 구분 (미설정 시 기본값: https://graph.microsoft.com/.default offline_access openid)
# offline_access가 없으면 refresh_token이 발급되지 않음
AZURE_SCOPES=https://graph.microsoft.com/.default offline_access openid


# =============================================================================
# 네트워크 바인드
# 자세한 설명: docs/environment_variables.md
# =============================================================================
# [중요] 기본 바인드 주소가 0.0.0.0 -> 127.0.0.1(loopback) 로 바뀌었다.
# 단일 운영자 모드(기본, 아래 "멀티유저 모드" 를 켜지 않은 상태)의 MCP 서버에는 호출자 인증이
# 전혀 없어서, 포트에 도달 가능한 사람은 누구나 인증 없이 메일/일정/파일을 읽고 쓸 수 있기 때문이다.
#
# 아무것도 설정하지 않으면 127.0.0.1 로 뜬다 — 이것이 안전한 기본값이다.
# MCP_BIND_HOST=127.0.0.1

# 외부(다른 PC)에서 접속해야 할 때만 아래 두 줄을 함께 켠다.
# MCP_BIND_HOST 만 바꾸면 옵트인이 없다고 판단해 loopback 으로 강등된다.
#
#   [경고] 켜기 전에 반드시 Windows 방화벽에서 출발지 IP 를 제한할 것.
#          가능하면 0.0.0.0 대신 특정 내부망 IP(예: 192.168.0.10)를 지정하고,
#          더 안전하게는 SSH 터널/WireGuard 로만 노출하라.
# MCP_BIND_HOST=192.168.0.10
# MCP_ALLOW_PUBLIC_BIND=1

# 서버가 listen 할 포트 (미설정 시 서버별 기본값, 예: outlook 5001)
# MCP_SERVER_PORT=5001

# Host / Origin 헤더 추가 허용 (쉼표 구분, host:* 와일드카드 가능). 기본은 localhost·127.0.0.1·[::1]
# MCP_ALLOWED_HOSTS=
# MCP_ALLOWED_ORIGINS=


# =============================================================================
# 파일 접근 허용 경로  (단일 운영자 모드 전용 — 멀티유저 모드에서는 설정하면 기동 거부)
# =============================================================================
# 파일 읽기/쓰기를 허용할 루트 목록. 구분자는 OS 기본값(Windows ';', Linux/macOS ':').
# 미설정 시 프로젝트 루트(+ MCP_DATA_DIR)만 허용된다.
# 허용 범위는 필요한 만큼만 좁게 잡을 것 (C:\ 나 홈 전체를 넣으면 의미가 없다).
# MCP_ALLOWED_PATHS=E:\dev\KR_MS365_mcp\downloads;E:\dev\KR_MS365_mcp\output

# 기본 허용 루트에 추가로 붙일 데이터 디렉터리
# MCP_DATA_DIR=


# =============================================================================
# 입력 검증
# =============================================================================
# 도구 입력 스키마 검증. 미설정이면 켜짐(권장).
# 0/false/no/off 로 두면 꺼진다 — 긴급 우회용이며 정상 운영 중에는 끄지 말 것.
# (멀티유저 모드에서는 0 으로 두면 기동 거부)
# MCP_VALIDATE_INPUT=1


# =============================================================================
# 기본 사용자  (단일 운영자 모드 전용 — 멀티유저 모드에서는 설정하면 기동 거부)
# =============================================================================
# 도구 호출에 이메일 인자가 없을 때 사용할 기본 사용자.
# 미설정 시 auth.db 의 계정 중 이메일 사전순으로 결정적으로 선택한다.
# MS365_DEFAULT_USER_EMAIL=user@example.com


# =============================================================================
# 멀티유저 모드  (spec/spec_멀티유저.md, 운영 절차: session/README.md "멀티유저 모드")
# =============================================================================
# 여러 사용자가 한 서버를 함께 쓴다. 사용자마다 bearer key·암호화 토큰 DB·업무 DB·파일 영역이
# 분리되고, Graph 연결은 중앙 auth gateway(python -m session.auth_gateway)가 처리한다.
# Streamable HTTP 전용 — 이 모드에서 stdio 서버는 기동을 거부한다.
#
# [비밀 취급] 아래 값 중 KEK·client secret 은 셸 기록·저장소에 남기지 말고 서비스 환경
# 또는 OS 보호 파일로 주입한다. 이 파일(.env.example)에는 실제 값을 절대 적지 않는다.
#
# 켜기 (0 또는 미설정 = 단일 운영자 모드)
# MS365_MULTI_USER=1
#
# 데이터 루트 — 반드시 절대경로. 저장소 밖(로컬 디스크)을 권장한다. OneDrive 동기화 폴더·
# 네트워크 공유(SMB/NFS)에 두지 않는다(단일 호스트 로컬 파일시스템만 지원).
# MS365_DATA_ROOT=D:\ms365-data
#
# 허용 tenant UUID 목록 (쉼표/공백 구분). 미설정이면 UUID 형식의 AZURE_TENANT_ID 하나.
# MS365_ALLOWED_TENANTS=<tenant-uuid>
#
# 중앙 OAuth 콜백 — 멀티유저에서는 위 AZURE_REDIRECT_URI 를 gateway 의 콜백으로 바꾼다.
# https 필수(http 는 loopback 만). Entra 앱 등록의 리디렉션 URI 와 같아야 한다.
# AZURE_REDIRECT_URI=https://mcp.example.com/auth/callback
# 브라우저 연결 링크의 공개 origin (미설정이면 AZURE_REDIRECT_URI 의 origin)
# MS365_PUBLIC_BASE_URL=https://mcp.example.com
#
# client secret — AZURE_CLIENT_SECRET 대신 파일로 주입할 수 있다(둘 다 없으면 PKCE public client).
# AZURE_CLIENT_SECRET_FILE=C:\ProgramData\ms365\client_secret.txt
#
# auth gateway 바인드 (미설정 시 포트 = AZURE_REDIRECT_URI 의 포트, 호스트 = loopback)
# MS365_AUTH_GATEWAY_PORT=5000
# MS365_AUTH_GATEWAY_HOST=127.0.0.1
#
# KEK provider — 사용자별 DEK 를 wrap 하는 키. **명시 선택, 자동 폴백 없음**(미설정이면 기동 거부).
#   azure_keyvault : 운영 권고. Key Vault RSA 키 + managed identity. `uv sync --extra keyvault` 필요
#   dpapi          : Windows 단일 호스트. 서비스 OS 계정에 바인딩
#   env            : 개발 전용 (기동 경고). MS365_KEK_B64 = 32바이트 난수 base64
#   (memory 는 테스트 전용 — MS365_TESTING=1 일 때만 동작, 운영에 쓰지 않는다)
# MS365_KEK_PROVIDER=azure_keyvault
# MS365_KEK_KEY_ID=https://<vault-name>.vault.azure.net/keys/<key-name>/<version>
# MS365_KEK_MI_CLIENT_ID=<user-assigned-managed-identity-client-id>
# MS365_KEK_B64=
#
# 요청 본문 상한 (바이트, 기본 4194304 = 4 MiB)
# MS365_MAX_REQUEST_BYTES=4194304
#
# 감사 로그(system/audit/*.jsonl)의 리소스 식별자 HMAC 키 (미설정이면 배포 ID)
# MS365_AUDIT_HMAC_KEY=
#
# 고급 — 기본값을 바꿀 일이 거의 없다
# MS365_ENTRA_AUTHORITY_HOST=https://login.microsoftonline.com
# MS365_GRAPH_BASE_URL=https://graph.microsoft.com/v1.0
#
# 멀티유저 모드에서 **설정하면 기동이 거부되는** 공용 설정:
#   MS365_DEFAULT_USER_EMAIL, MCP_ALLOWED_PATHS, MCP_DATA_DIR, DB_PATH,
#   MCP_ATTACHMENT_TEMP_DIR, MCP_ATTACHMENT_OUTPUT_DIR, MCP_ATTACHMENT_METADATA_PATH,
#   MCP_ATTACHMENT_LOG_FILE, MCP_VALIDATE_INPUT=0


# =============================================================================
# 기타
# =============================================================================
# 도구 계약(spec/param_spec/<도메인>.yaml) 위치 직접 지정.
# 소스 트리에서 실행하면 자동 해석되므로 wheel 로 설치해 쓸 때만 필요하다.
# MCP_PARAM_SPEC_DIR=
