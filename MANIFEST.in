# sdist 에 도구 계약을 동봉한다 — spec/param_spec/<도메인>.yaml 은 런타임 필수다
# (도구 계약의 유일한 원본, spec/spec_도구정의.md). wheel 에는 패키지 밖이라 안 들어가며,
# 설치본 실행 시에는 MCP_PARAM_SPEC_DIR 환경변수로 위치를 지정한다.
recursive-include spec/param_spec *.yaml

# 멀티유저 데이터 루트(<repo>/data)·감사 로그·키·DB·비밀은 어떤 배포물에도 싣지 않는다
# (spec/spec_멀티유저.md ②-7.2 — repo·wheel·배포 번들에 data/ 를 포함하지 않는다)
prune data
global-exclude *.db *.sqlite *.sqlite3 *.jsonl wrapped_dek.json *.key *.kek *.pem *.pfx *.p12 .env
