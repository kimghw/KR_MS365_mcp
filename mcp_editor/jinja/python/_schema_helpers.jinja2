{# _schema_helpers.jinja2 - 생성된 서버에 baked-in 되는 스키마 헬퍼 (단일 정의 지점) #}
# ============================================================
# 스키마 정규화 / boolean <-> enabled·disabled 변환
# ============================================================
# !! 동기화 주의 !!
# 이 코드의 규칙은 mcp_editor/service_registry/schema_normalize.py 가 SSOT 다.
# 생성된 서버는 mcp_editor(에디터 도구)에 의존하면 안 되므로 import 로 합칠 수
# 없고, 대신 같은 규칙을 여기 한 곳에만 적어 둔다.
# schema_normalize.py 를 고치면 이 파일도 함께 고쳐야 한다.
#
# 예전에는 이 로직이 generate_universal_server.py 와 템플릿 본문에 각각 복사돼
# 있었고 한쪽만 description 접미사를 붙여서, 생성 시점에 구워진 스키마와
# 실행 시점에 YAML 에서 다시 읽은 스키마가 달라졌다. 이제 양쪽이 일치한다.

# boolean 을 대체하는 문자열 enum (OpenAI function-calling 이 boolean 미지원)
ENABLED = "enabled"
DISABLED = "disabled"
ENABLED_DISABLED_ENUM = [ENABLED, DISABLED]
BOOL_DESCRIPTION_SUFFIX = " (enabled=true, disabled=false)"


def _normalize_input_schema(schema: Any) -> Dict[str, Any]:
    """inputSchema 를 항상 {"type": "object", "properties": {...}} 형태로 정규화한다.

    입력 검증이 켜진 뒤에는 스키마 형태가 곧 계약이다. YAML 에서 inputSchema 가
    아예 없거나, type 이 빠졌거나, properties 가 없는 경우가 섞여 있으면
    list_tools 로 노출되는 스키마와 실제 검증 기준이 어긋난다.

    `required` 를 비롯한 나머지 키는 그대로 보존한다(절대 버리지 않는다).
    """
    if not isinstance(schema, dict):
        return {"type": "object", "properties": {}}

    result = dict(schema)
    result["type"] = result.get("type") or "object"

    properties = result.get("properties")
    result["properties"] = properties if isinstance(properties, dict) else {}

    # required 는 리스트로 정규화하되 내용은 보존한다.
    required = result.get("required")
    if required is None:
        result.pop("required", None)
    elif isinstance(required, str):
        result["required"] = [required]
    elif isinstance(required, (list, tuple, set)):
        result["required"] = [str(item) for item in required]
    else:
        result.pop("required", None)

    return result


def _convert_boolean_schema_to_enabled_disabled(schema: Any) -> Dict[str, Any]:
    """boolean 타입 속성을 enabled/disabled 문자열 enum 으로 변환한다.

        type: boolean, default: true  -> type: string, enum: [...], default: "enabled"
        type: boolean, default: false -> type: string, enum: [...], default: "disabled"

    중첩 object 도 재귀 처리하며, 멱등하다(다시 적용해도 결과가 같다).
    `required` 는 건드리지 않는다.
    """
    if not isinstance(schema, dict):
        return schema

    result = dict(schema)

    properties = result.get("properties")
    if not isinstance(properties, dict):
        return result

    new_properties: Dict[str, Any] = {}
    for prop_name, prop_def in properties.items():
        if not isinstance(prop_def, dict):
            new_properties[prop_name] = prop_def
            continue

        prop_type = prop_def.get("type")

        if prop_type == "boolean":
            new_prop = dict(prop_def)
            new_prop["type"] = "string"
            new_prop["enum"] = list(ENABLED_DISABLED_ENUM)

            if "default" in new_prop:
                new_prop["default"] = ENABLED if new_prop["default"] else DISABLED

            description = new_prop.get("description")
            # 멱등: 접미사가 이미 있으면 다시 붙이지 않는다.
            if description and not description.endswith(BOOL_DESCRIPTION_SUFFIX):
                new_prop["description"] = f"{description}{BOOL_DESCRIPTION_SUFFIX}"

            new_properties[prop_name] = new_prop

        elif prop_type == "object":
            new_properties[prop_name] = _convert_boolean_schema_to_enabled_disabled(prop_def)

        else:
            new_properties[prop_name] = prop_def

    result["properties"] = new_properties
    return result


def convert_enabled_to_bool(value: Any) -> bool:
    """"enabled"/"disabled" 문자열을 bool 로 되돌린다."""
    if isinstance(value, bool):
        return value
    if isinstance(value, str):
        return value.strip().lower() == ENABLED
    return False


def convert_bool_to_enabled(value: Any) -> str:
    """bool 을 "enabled"/"disabled" 문자열로 바꾼다."""
    return ENABLED if value else DISABLED


def coerce_boolean_enums_for_schema(schema: Any, arguments: Any) -> Dict[str, Any]:
    """검증 **전에** 구형 클라이언트의 실제 bool 값을 enabled/disabled 로 정규화한다.

    YAML 의 boolean 파라미터는 OpenAI 호환을 위해 enabled/disabled 문자열 enum 으로
    노출된다. 입력 검증이 켜진 뒤로는 클라이언트가 진짜 bool(`true`)을 보내면
    "expected type string" 으로 거절된다. 하위 호환을 위해 여기서 흡수한다.

    각 프로토콜 템플릿은 `coerce_boolean_enums(tool_name, arguments)` 라는 얇은
    래퍼로 이 함수를 호출한다(스키마 조회만 프로토콜별 runtime 객체에서 한다).
    """
    properties = (schema or {}).get("properties") or {}
    coerced = dict(arguments or {})
    for name, value in list(coerced.items()):
        prop = properties.get(name)
        if not isinstance(prop, dict) or not isinstance(value, bool):
            continue
        if prop.get("type") == "string" and prop.get("enum") == ENABLED_DISABLED_ENUM:
            coerced[name] = convert_bool_to_enabled(value)
    return coerced
