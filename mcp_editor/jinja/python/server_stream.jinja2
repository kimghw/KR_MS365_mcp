{# server_stream.jinja2 - Streamable HTTP Protocol Implementation (MCP SDK) #}
# ============================================================
# Streamable HTTP Protocol Implementation for MCP Server
# ============================================================
# 공식 MCP Python SDK 의 Streamable HTTP transport (spec: MCP 2025-03-26) 사용.
# `StreamableHTTPSessionManager` 를 Starlette 앱에 마운트하고 uvicorn 으로 서빙한다.
# 단일 엔드포인트 `/mcp` 가 POST + GET + DELETE 를 처리하며, 스펙에 맞는
# `Mcp-Session-Id` 헤더 세션 관리와 Accept 헤더 협상(JSON vs SSE)을 지원한다.
#
# 도구 핸들러, env 로딩, BOM 제거, YAML 도구 정의 로딩은 상위(universal) 템플릿에 있다.
#
# ------------------------------------------------------------
# 이 파일이 만들어내는 transport 계층은 직접 구현을 갖지 않는다.
# dispatch / 기본값 주입 / 입력 검증 / 오류 정규화 / 서비스 lifecycle / health 는
# 전부 `mcp_common` 의 공통 구현에 위임한다 (SSOT).
# 예전 버전은 아래 결함을 모든 도메인 서버에 복제했었다:
#   - 도구 실패를 status:error TextContent 로 반환해 성공처럼 보이게 함
#     (지금은 예외를 올려 SDK 가 isError=True 로 표시한다)
#   - 입력 검증 비활성화 → 스키마 required 와 핸들러 필수 인자의 불일치가
#     런타임 KeyError 로만 드러남 (지금은 ToolRuntime 이 검증)
#   - 초기화 실패를 경고만 하고 health 는 계속 healthy 반환
#     (지금은 ServiceLifecycle 이 기록하고 health 가 degraded/503 을 반환)
#   - 서비스 close() 미호출 (지금은 lifespan 종료 시 shutdown 호출)
#   - 바인드 기본값 0.0.0.0 (지금은 resolve_bind_host 로 loopback 기본)
# ------------------------------------------------------------

import mcp.types as mcp_types
from mcp.server.lowlevel import Server as MCPServer
from mcp.server.streamable_http_manager import StreamableHTTPSessionManager
from starlette.applications import Starlette
from starlette.routing import Route
from starlette.responses import JSONResponse
from starlette.requests import Request as StarletteRequest

from mcp_common.net import resolve_bind_host
from mcp_common.runtime import (
    ToolRuntime,
    ServiceLifecycle,
    build_health_payload,
    health_status_code,
)

# Use the logger from parent template
logger = logging.getLogger(__name__)

SERVER_NAME = "{{ server_name }}"
SERVER_VERSION = "1.0.0"


# ============================================================
# Tool dispatch table (maps tool name -> handler function)
# ============================================================

TOOL_HANDLERS = {
{%- for tool in tools %}
    "{{ tool.name }}": handle_{{ tool.tool_name or tool.name }},
{%- endfor %}
}


# ============================================================
# 공통 런타임 / 서비스 lifecycle
# ============================================================
# ToolRuntime: 도구 객체 생성 + 기본값 주입 + 입력 검증 + 동기/비동기 핸들러 +
#              오류 정규화(실패는 예외로 전파되어 SDK 가 isError=True 로 만든다)
runtime = ToolRuntime(SERVER_NAME, MCP_TOOLS, TOOL_HANDLERS)

# ServiceLifecycle: 서비스 initialize()/close() 를 일관되게 처리하고
#                   초기화 실패를 health 응답에 반영한다.
lifecycle = ServiceLifecycle(SERVER_NAME, [
{%- for key, service_info in unique_services.items() %}
    {{ service_info.instance }},
{%- endfor %}
])


def coerce_boolean_enums(tool_name: str, arguments: Dict[str, Any]) -> Dict[str, Any]:
    """구형 클라이언트가 보낸 실제 bool 을 검증 전에 enabled/disabled 로 정규화."""
    return coerce_boolean_enums_for_schema(runtime.input_schema(tool_name), arguments)


# ============================================================
# MCP SDK: Server + Streamable HTTP transport
# ============================================================

def build_mcp_server() -> MCPServer:
    """도구가 등록된 MCP lowlevel Server 를 만든다."""
    server: MCPServer = MCPServer(name=SERVER_NAME, version=SERVER_VERSION)

    tool_objects = runtime.build_tool_objects()

    @server.list_tools()
    async def _list_tools() -> List[mcp_types.Tool]:
        return tool_objects

    # validate_input=False 는 "검증하지 않는다"는 뜻이 아니다.
    # SDK 기본 검증 대신 ToolRuntime 이 list_tools 로 노출한 바로 그 스키마
    # (enabled/disabled 변환이 적용된 형태)를 기준으로 검증한다.
    @server.call_tool(validate_input=False)
    async def _call_tool(name: str, arguments: Dict[str, Any]):
        return await runtime.dispatch(name, coerce_boolean_enums(name, arguments or {}))

    return server


def build_starlette_app() -> Starlette:
    """`/mcp` 에 Streamable HTTP MCP 엔드포인트를 붙인 Starlette ASGI 앱을 만든다."""
    mcp_server = build_mcp_server()

    session_manager = StreamableHTTPSessionManager(
        app=mcp_server,
        event_store=None,
        json_response=False,   # Accept 헤더에 따라 JSON/SSE 협상
        stateless=False,       # Mcp-Session-Id 기반 stateful 세션
    )

    # Starlette Route 가 ASGI 앱으로 그대로 취급하도록 클래스로 감싼다
    # (메서드 필터링/request_response 래핑 없음). FastMCP 와 동일한 방식.
    class _StreamableHTTPASGI:
        def __init__(self, sm: StreamableHTTPSessionManager):
            self._sm = sm

        async def __call__(self, scope, receive, send) -> None:
            await self._sm.handle_request(scope, receive, send)

    handle_streamable_http = _StreamableHTTPASGI(session_manager)

    async def health(_request: StarletteRequest) -> JSONResponse:
        # 초기화에 실패한 서비스가 있으면 status="degraded" + HTTP 503 이 된다.
        payload = build_health_payload(
            SERVER_NAME,
            runtime,
            lifecycle,
            version=SERVER_VERSION,
            protocol="streamable-http",
        )
        return JSONResponse(payload, status_code=health_status_code(payload))

    @contextlib.asynccontextmanager
    async def lifespan(_app: Starlette) -> AsyncIterator[None]:
        async with session_manager.run():
            await lifecycle.startup()
            if lifecycle.errors:
                # 프로세스를 죽이지는 않지만 health 가 degraded 로 알린다.
                logger.error(
                    "{{ server_title }} started with %d service initialization error(s): %s",
                    len(lifecycle.errors),
                    "; ".join(lifecycle.errors),
                )
            logger.info(
                "{{ server_title }} Streamable HTTP server ready with %d tools",
                len(runtime.tools),
            )
            try:
                yield
            finally:
                await lifecycle.shutdown()

    # NOTE: Mount 가 아니라 Route(path="/mcp", endpoint=<ASGI app>) 를 쓴다.
    # ASGI 호출 가능 객체를 endpoint 로 주면 모든 HTTP 메서드(GET/POST/DELETE)가
    # 그 객체로 디스패치되고, Mount 에서 발생하는 trailing-slash 리다이렉트가 없다.
    return Starlette(
        debug=False,
        routes=[
            Route("/mcp", endpoint=handle_streamable_http),
            Route("/health", endpoint=health, methods=["GET"]),
        ],
        lifespan=lifespan,
    )


# Module-level ASGI app (so `uvicorn server_stream:app` also works)
app = build_starlette_app()


def run(host: Optional[str] = None, port: int = {{ stream_port | default(port | default(8001)) }}) -> None:
    """진입점: uvicorn 으로 Streamable HTTP 서버를 띄운다.

    host 기본값은 None 이며 `resolve_bind_host()` 가 결정한다(기본 127.0.0.1).
    MCP 서버에는 호출자 인증 계층이 없어서 0.0.0.0 으로 열면 네트워크상의 누구나
    사용자 메일/파일에 접근할 수 있다. 외부 노출이 필요하면 명시적으로 옵트인한다:
        MCP_BIND_HOST=0.0.0.0 MCP_ALLOW_PUBLIC_BIND=1
    """
    import uvicorn
    bind_host = resolve_bind_host(host, server_name=SERVER_NAME)
    # Configure logging at run-time (HTTP transport: stderr is fine for logs)
    logging.basicConfig(
        level=logging.INFO,
        format='%(asctime)s - %(name)s - %(levelname)s - %(message)s',
        stream=sys.stderr,
    )
    logger.info(f"Starting {{ server_title }} Streamable HTTP server on {bind_host}:{port}")
    uvicorn.run(app, host=bind_host, port=port, log_level="info")
